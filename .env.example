# Spring Boot Backend Environment Configuration
# Copy this to .env for local testing with PostgreSQL / Supabase

PORT=8080

# Supabase PostgreSQL Database Settings
# Project: zabxtltqxpmfvjsvmwfv (https://zabxtltqxpmfvjsvmwfv.supabase.co)
SPRING_DATASOURCE_URL=jdbc:postgresql://db.zabxtltqxpmfvjsvmwfv.supabase.co:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres
# Enter your Supabase database password (configured in Supabase Project Settings > Database)
SPRING_DATASOURCE_PASSWORD=&Sakthi123&
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
SPRING_JPA_DATABASE_PLATFORM=org.hibernate.dialect.PostgreSQLDialect

# Supabase API Metadata (Optional reference)
SUPABASE_URL=https://zabxtltqxpmfvjsvmwfv.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_6jCrEkm9C6wmsunJWgQiSA_yiH8Gq63

# Safe schema migrations (preserves existing data)
SPRING_JPA_HIBERNATE_DDL_AUTO=update
FLYWAY_ENABLED=true

# Connection Pool Settings (optimized for Supabase connection limits)
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2

# Security & CORS
